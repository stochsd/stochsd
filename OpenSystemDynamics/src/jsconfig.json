{
	// Makes VS Code treat all scripts as one project, like the browser does when index.html loads them.
	// This gives go to definition, find all references, rename and hover info across files.
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		// Files are only type checked if they start with // @ts-check
		"checkJs": false,
		// Without types, strict mode mostly gives noise in plain JavaScript
		"strict": false,
		// Type definitions for the libraries, copied from @types/jquery and @types/jqueryui
		"typeRoots": ["./types"],
		"types": ["jquery", "jqueryui"]
	},
	"include": [
		"*.js",
		"editor/**/*.js",
		"insightmaker/**/*.js",
		"libs/*.js",
		"codemirror/lib/codemirror.js",
		"types/*.d.ts"
	],
	"exclude": [
		// Minified or generated, only slows down the editor
		"insightmaker/SimulationEngine/calc/antlr3-all-min.js",
		"insightmaker/SimulationEngine/calc/output/**",
		"insightmaker/resources/jstat.min.js"
	],
	"typeAcquisition": {
		// The library type definitions are in types/ instead
		"enable": false
	}
}
